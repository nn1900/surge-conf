{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "vless-reality",
      "listen": "0.0.0.0",
      "port": {{port}},
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "{{uuid}}", "flow": "xtls-rprx-vision" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "dest": "{{serverName}}:443",
          "serverNames": ["{{serverName}}"],
          "privateKey": "{{privateKey}}",
          "shortIds": ["{{shortId}}"]
        }
      },
      "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": {
    "rules": [
      { "type": "field", "ip": ["geoip:private", "100.64.0.0/10"], "outboundTag": "block" }
    ]
  }
}
