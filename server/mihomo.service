[Unit]
Description=mihomo local proxy (127.0.0.1 only)
Documentation=https://wiki.metacubex.one
After=network-online.target
Wants=network-online.target

[Service]
User=mihomo
Group=mihomo
ExecStart=/usr/local/bin/mihomo -d /var/lib/mihomo -f /etc/mihomo/config.yaml
# The home directory holds Country.mmdb and the selection cache.
ReadWritePaths=/var/lib/mihomo
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
